# Porta do Servidor Node (Padrão: 3333)
PORT=3333

# Configuração do PostgreSQL (No Docker local, mapeamos para a porta 5433)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://docker:dockerpassword@localhost:5433/syngate_db?schema=public"  

# Configuração do Redis (Padrão Docker: localhost:6379)
REDIS_URL="redis://localhost:6379" 

# Configuração do CORS (Domínios permitidos para acessar a API, separados apenas por vírgula)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Segurança (Segredo usado para assinar os tokens JWT)
# No ambiente de desenvolvimento, pode ser qualquer palavra ou número.
# Use o comando "node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" para gerar um segredo forte."
JWT_SECRET="insira-qualquer-senha-aqui"

# Ambiente de execução (development, production, test)
NODE_ENV="development"