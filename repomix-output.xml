  // ---------------------------------------------------------
  // 5. LOGS DE ACESSO
  // ---------------------------------------------------------
  console.log('📊 Gerando Logs de Acesso para testes de UI...');

  const totalLogs = await prisma.logAcesso.count();

  if (totalLogs === 0) {
    await prisma.logAcesso.createMany({
