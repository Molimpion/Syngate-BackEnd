  const catracaEntrada = await prisma.dispositivo.upsert({
    where: { enderecoMac: 'AA:BB:CC:DD:EE:01' },
    update: {},
    create: {
      nome: 'Catraca Principal',
      tipo: TipoDispositivo.CATRACA,
      enderecoMac: 'AA:BB:CC:DD:EE:01',
