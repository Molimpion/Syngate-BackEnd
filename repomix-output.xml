} from '@prisma/client';
import { hashPassword } from '../src/utils/hash';
import { hashDeviceKey } from '../src/utils/device-key';

const prisma = new PrismaClient();

async function main() {
  console.log('🌱 Iniciando expansão de dados do Seed com horários granulares...');

